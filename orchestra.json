{
  "$schema": "./schemas/orchestra.schema.json",
  "schemaVersion": 1,
  "runtime": {
    "primary": "herdr",
    "harness": "opencode",
    "desktopRequired": false
  },
  "portability": {
    "excludedSkillPaths": ["omarchy"]
  },
  "team": {
    "name": "development",
    "entrypoint": "dev-lead",
    "workflow": [
      { "phase": "plan", "role": "dev-planner" },
      { "phase": "build", "role": "dev-builder" },
      { "phase": "verify", "role": "dev-tester" },
      { "phase": "prove", "role": "dev-auditor" }
    ]
  },
  "modelPolicy": {
    "inventoryBeforeDispatch": true,
    "humanConfirmationBeforeFirstDispatch": false,
    "recordActualTokensAndCost": true,
    "classes": {
      "coordination": "mid",
      "planning": "mid",
      "implementation": "mid",
      "testing": "economy",
      "audit": "strongest"
    },
    "roles": {
      "dev-lead": ["openai/gpt-5.6-luna", "openai/gpt-5.6-terra", "opencode-go/kimi-k2.7-code"],
      "dev-planner": ["openai/gpt-5.6-terra", "openai/gpt-5.6-luna", "opencode-go/kimi-k2.7-code"],
      "dev-builder": ["opencode-go/kimi-k2.7-code", "openai/gpt-5.6-luna", "opencode-go/deepseek-v4-flash"],
      "dev-tester": ["opencode-go/deepseek-v4-flash", "opencode-go/kimi-k2.7-code", "openai/gpt-5.6-luna"],
      "dev-auditor": ["openai/gpt-5.6-sol", "openai/gpt-5.6-terra", "opencode-go/kimi-k2.7-code"]
    }
  },
  "safety": {
    "safeOperationsRunUnattended": true,
    "externalWrites": "deny",
    "destructiveOperations": "deny",
    "executorCannotApproveOwnWork": true
  },
  "evidence": {
    "requireVerification": true,
    "requireIndependentAudit": true,
    "requireHandoff": true
  }
}
